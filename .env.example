# Listener for client (forward-proxy) traffic. Point 9router upstreams here.
LISTEN_ADDR=:8080

# Admin listener (loopback): GET /healthz, GET /status. Always on; Docker
# HEALTHCHECK requires it. Must differ from LISTEN_ADDR.
ADMIN_ADDR=127.0.0.1:8081
# Pool file: one upstream proxy per line (http://, https://, socks5://).
PROXIES_FILE=configs/proxies.txt

# Attempts per request across distinct proxies (1 = no retry).
MAX_RETRIES=3

# Failure cooldown: base doubles per consecutive failure, capped at max.
COOLDOWN_BASE=15s
COOLDOWN_MAX=10m

# Upstream dial + handshake timeout.
CONNECT_TIMEOUT=10s

# Accept self-signed certificates on https:// upstream proxies. Also disables
# target certificate verification on the plain-HTTP forwarding path.
UPSTREAM_TLS_INSECURE=false

# Request bodies up to this size are buffered so POSTs can replay on proxy
# rotation; larger bodies stream through a single proxy with no retry. Bytes.
MAX_BODY_BUFFER=67108864

# debug | info | warn | error
LOG_LEVEL=info
