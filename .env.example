# Listener for client (forward-proxy) traffic. Point 9router upstreams here.
LISTEN_ADDR=:8080

# Admin listener (loopback): GET /healthz, GET /status. Always on; Docker
# HEALTHCHECK requires it. Must differ from LISTEN_ADDR.
ADMIN_ADDR=127.0.0.1:8081
# SOCKS5 pool file: one route per line. Accepted forms are socks5://host:port,
# socks5://user:pass@host:port, host:port:user:pass, and user:pass@host:port.
PROXIES_FILE=configs/proxies.txt

# Attempts across distinct routes after endpoint dial or SOCKS auth failure.
MAX_RETRIES=3

# Endpoint TCP dial cooldown: base doubles per consecutive failure, capped at max.
COOLDOWN_BASE=15s
COOLDOWN_MAX=10m

# SOCKS endpoint dial and setup timeout.
CONNECT_TIMEOUT=10s

# Accept self-signed certificates on HTTPS targets reached through SOCKS5.
TARGET_TLS_INSECURE=false

# Request bodies up to this size are buffered so POSTs can replay after an
# endpoint dial/auth fallback; larger bodies stream once. Bytes.
MAX_BODY_BUFFER=67108864

# debug | info | warn | error
LOG_LEVEL=info
