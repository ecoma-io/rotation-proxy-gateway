# rotation-proxy-gateway — bootstrap environment sample.
#
# Every bootstrap variable carries the RPGW_ prefix and is read exactly once
# at process start: changing a value requires a restart. Runtime behavior and
# routes live in the YAML config named by RPGW_CONFIG_FILE, hot-reloaded every
# second — none of that is configurable here.
#
# Copy to .env (Git-ignored) and either export it before a bare-metal run
# (set -a; . ./.env; set +a) or pass it to Docker (docker run --env-file .env).
# Defaults are shown commented out; uncomment and edit what you need.

# Runtime YAML path (default: config.yaml).
#RPGW_CONFIG_FILE=config.yaml

# Admin (HTTP) listener serving /healthz, /readyz, and /status (default:
# 0.0.0.0:30120). Network exposure is controlled by port publishing, firewalls,
# and network policy — not by this address alone.
#RPGW_ADMIN_ADDR=0.0.0.0:30120

# Optional PostgreSQL DSN for durable configuration revisions. A real value is
# secret (it commonly embeds a password): never log, commit, or share it. When
# set, the authenticated /control API is required and RPGW_ADMIN_TOKEN must be
# non-empty or startup refuses to proceed. Unset keeps file-seeded config.yaml
# mode and does not mount /control.
#RPGW_CONFIG_STORE_DSN=

# Optional positive Go duration for durable-store reconciliation. Unset takes
# the documented control package default.
#RPGW_RECONCILE_INTERVAL=

# Opaque bearer token for authenticated /control/* operations. Clients present
# Authorization: Bearer <token>. A real value is a credential: never log,
# commit, share, or put it in a URL. Required when RPGW_CONFIG_STORE_DSN is set.
#RPGW_ADMIN_TOKEN=

# HTTP forward-proxy listeners (mixed/v4/v6 egress views). An explicitly empty
# value disables that listener,
# but at least one must remain enabled, and enabled addresses must not overlap
# (including wildcard binds on the same port).
#RPGW_MIXED_LISTEN_ADDR=:30121
#RPGW_V4_LISTEN_ADDR=:30122
#RPGW_V6_LISTEN_ADDR=:30123
# To disable one listener instead, set it empty:
#RPGW_V6_LISTEN_ADDR=

# Total shared drain budget for graceful shutdown, one deadline for the whole
# process (Go duration, default: 55s). Keep the orchestrator's kill timer
# above it — compose stop_grace_period: 60s, for example.
#RPGW_SHUTDOWN_GRACE=55s

# Optional `username:password` requiring `Proxy-Authorization: Basic` on every
# proxy listener (RFC 7617 over the HTTP forward-proxy credential; the field
# limits are inherited from the SOCKS5 era's RFC 1929 exchange, kept so an
# existing account keeps working). Unset or empty keeps the no-authentication
# default. Split at the first colon (the password may contain colons);
# username 1-255 bytes, password 0-255 bytes — anything else fails startup.
# A real value is a credential: never log, commit, or share it.
#RPGW_ACCOUNT=
